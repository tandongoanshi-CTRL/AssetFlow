# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5434/assetflow_auth

# Security
JWT_ACCESS_TTL_SECONDS=3600
# session validation is 60 minutes; we'll also store sessions server-side
SESSION_TTL_SECONDS=3600

# Password reset
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
# In this template we "send" reset token by console; later you can replace with real email provider.

